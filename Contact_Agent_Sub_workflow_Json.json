      "id": "d89f0eed-8bca-41b1-a927-9822c52b1b3b",
      "name": "Get row(s) in sheet",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const input = $('Normalize ElevenLabs Request').isExecuted\n  ? $('Normalize ElevenLabs Request').first().json\n  : $('When Executed by Another Workflow').first().json;\nconst norm = (v) => String(v ?? '').trim().toLowerCase();\nconst digits = (v) => String(v ?? '').replace(/\\D/g, '');\nconst name = norm(input.name);\nconst email = norm(input.email);\nconst phone = digits(input.phone);\n\nconst rows = $input.all().map((i) => i.json).filter((r) => r && (r.Name || r.Email || r.Phone));\n\nconst matches = rows.filter((r) => {\n  const rn = norm(r.Name);\n  const re = norm(r.Email);\n  const rp = digits(r.Phone);\n  const byName = name && rn.includes(name);\n  const byEmail = email && re === email;\n  const byPhone = phone.length >= 6 && rp.endsWith(phone.slice(-9));\n  return byName || byEmail || byPhone;\n});\n\nif (!matches.length) {\n  return [{ json: { result: 'No matching contact found' } }];\n}\nreturn matches.map((m) => ({ json: m }));"
      },
      "id": "98d1e85c-b8d8-4059-9489-1ed10c566e76",
