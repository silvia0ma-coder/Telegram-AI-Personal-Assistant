{
  "name": "Email Management Sub Workflow",
  "nodes": [
    {
      "parameters": {
        "inputSource": "jsonExample",
        "jsonExample": "{\n  \"query\": \"a string\"\n}"
      },
      "id": "c2896da3-4109-4aa3-ad34-b568b284655c",
